# Standalone lint flist for the new obi_spi (spi_host OBI<->TL-UL) block.
# Not yet wired into croc_sim.flist -- this checks it compiles/elaborates
# in isolation before integration into user_domain.sv.
# Paths relative to this file's location (repo root/flists).

+incdir+../rtl/obi/include
+incdir+../rtl/obi_spi/vendor/opentitan

+define+TARGET_RTL
+define+TARGET_VERILATOR
+define+VERILATOR=1

# ---- deps from elsewhere in Croc ----
../rtl/common_cells/cf_math_pkg.sv
../rtl/obi/obi_pkg.sv
../rtl/register_interface/lowrisc_opentitan/prim_subreg.sv
