# Common setup of the open-source synthesis flow (structure after pulp-platform/croc yosys/scripts/yosys_common.tcl,
# Apache-2.0, ETH Zurich and University of Bologna).

# the flist is generated by oss/prep_rtl.py (absolute paths, SRAM wrapper without power ties)
set sv_flist   [file normalize "../build/croc_oss.flist"]
set out_dir    out
set tmp_dir    tmp
set rep_dir    reports

# local-var <- environment variable, with fallback
set proj_name  [expr {[info exists ::env(PROJ_NAME)]  ? $::env(PROJ_NAME)  : "croc_soc"}]
set top_design [expr {[info exists ::env(TOP_DESIGN)] ? $::env(TOP_DESIGN) : "croc_soc"}]
# ABC delay target in ps (per combinational cloud); override with SYNTH_PERIOD_PS
set period_ps  [expr {[info exists ::env(SYNTH_PERIOD_PS)] ? $::env(SYNTH_PERIOD_PS) : 40000}]

file mkdir $out_dir
file mkdir $tmp_dir
file mkdir $rep_dir

puts "using: sv_flist   = '$sv_flist'"
puts "using: top_design = '$top_design'"
puts "using: proj_name  = '$proj_name'"
puts "using: period_ps  = '$period_ps'"

# process ABC script and write to temporary directory
proc processAbcScript {abc_script} {
    global tmp_dir
    set abc_out_path $tmp_dir/[file tail $abc_script]
    set raw [read -nonewline [open $abc_script r]]
    set abc_script_recaig [string map -nocase [list "{REC_AIG}" [subst "src/lazy_man_synth_library.aig"]] $raw]
    set abc_out [open $abc_out_path w]
    puts -nonewline $abc_out $abc_script_recaig
    flush $abc_out
    close $abc_out
    return $abc_out_path
}
